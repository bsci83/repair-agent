# Anthropic API key for the agent's model client.
# Get one at https://console.anthropic.com/ .
ANTHROPIC_API_KEY=sk-ant-...

# Which model to use. Claude Sonnet is the default — fast and cheap enough
# for a portfolio demo, good enough at structured classification.
ANTHROPIC_MODEL=claude-sonnet-4-5

# Optional: point at an Anthropic-compatible endpoint (e.g. MiniMax.io).
# ANTHROPIC_BASE_URL=https://api.minimax.io/anthropic

# Activity log override. Defaults to <cwd>/.activity.log when unset.
# REPAIR_AGENT_ACTIVITY_LOG=/path/to/activity.jsonl